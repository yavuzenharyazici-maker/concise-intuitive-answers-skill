{"parentUuid": "4fbb8cea-a8c6-5fc5-a562-34f83226ec07", "isSidechain": false, "type": "user", "uuid": "4927b929-033d-52a4-bec9-38db14b31a15", "timestamp": "2026-01-01T00:00:02.000Z", "userType": "external", "cwd": "/tmp", "sessionId": "7f0d02a8-24a1-53b5-83aa-c2b140ea4910", "version": "2.1.323", "message": {"role": "user", "content": "What causes tides?"}}
{"parentUuid": "4927b929-033d-52a4-bec9-38db14b31a15", "isSidechain": false, "type": "assistant", "uuid": "a6a0baae-afc4-5f82-bfee-6f9777ee9198", "timestamp": "2026-01-01T00:00:03.000Z", "userType": "external", "cwd": "/tmp", "sessionId": "7f0d02a8-24a1-53b5-83aa-c2b140ea4910", "version": "2.1.323", "message": {"id": "msg_a6a0baaeafc45f82bfee6f97", "type": "message", "role": "assistant", "model": "claude-sonnet-5-5", "content": [{"type": "text", "text": "The Moon's gravity pulls harder on the near side of Earth than on the far side, which stretches the oceans into two bulges. Earth rotates under those bulges, so most coasts see two high tides a day. The Sun adds a smaller effect of the same kind."}], "stop_reason": "end_turn", "stop_sequence": null, "usage": {"input_tokens": 0, "output_tokens": 0}}}
{"parentUuid": "a6a0baae-afc4-5f82-bfee-6f9777ee9198", "isSidechain": false, "type": "user", "uuid": "df93b78b-4ffe-5b85-9eb4-050e6630b76b", "timestamp": "2026-01-01T00:00:04.000Z", "userType": "external", "cwd": "/tmp", "sessionId": "7f0d02a8-24a1-53b5-83aa-c2b140ea4910", "version": "2.1.323", "message": {"role": "user", "content": "Why is the ocean salty?"}}
{"parentUuid": "df93b78b-4ffe-5b85-9eb4-050e6630b76b", "isSidechain": false, "type": "assistant", "uuid": "d99f88d4-15d9-5a9a-8b8d-c7502ed20ddb", "timestamp": "2026-01-01T00:00:05.000Z", "userType": "external", "cwd": "/tmp", "sessionId": "7f0d02a8-24a1-53b5-83aa-c2b140ea4910", "version": "2.1.323", "message": {"id": "msg_d99f88d415d95a9a8b8dc750", "type": "message", "role": "assistant", "model": "claude-sonnet-5-5", "content": [{"type": "text", "text": "Rain dissolves minerals out of rocks and rivers carry them to the sea. Water leaves the ocean by evaporation but the salts stay, so they have built up over billions of years."}], "stop_reason": "end_turn", "stop_sequence": null, "usage": {"input_tokens": 0, "output_tokens": 0}}}
